# ==============================================================================
# AOTMS CRM & Telecommunication - Production Environment Configuration
# ==============================================================================

# Core Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas Cloud Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aotms_crm?retryWrites=true&w=majority
ALLOW_MEMORY_DB_FALLBACK=false

# Security & Authentication (Generate using: openssl rand -hex 32)
JWT_SECRET=replace_with_a_super_secure_random_64_character_hex_key_here

# Cross-Origin & Live Domain
FRONTEND_URL=https://crm.academyoftechmasters.com
PUBLIC_BASE_URL=https://crm.academyoftechmasters.com

# Firebase Cloud Messaging (Push Notifications for Mobile App)
# Base64-encoded string of firebase-adminsdk.json (avoids placing secret json files on disk)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Alternatively, paste raw JSON string:
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudinary Voice Call Recording Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Transcription Service (OpenAI Whisper)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Meta WhatsApp Cloud API (Optional)
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERIFY_TOKEN=zest_eat_meta_verify_8f9q2a
N8N_META_LEADS_WEBHOOK_URL=https://aotms.app.n8n.cloud/webhook/Meta_Leads

# Telephony Integrations (Optional)
KNOWLARITY_API_KEY=
CALLERDESK_API_KEY=
MAQSAM_ACCESS_KEY=
MAQSAM_SECRET_KEY=

# Email CRM (Resend or SMTP)
RESEND_API_KEY=re_your_resend_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.com
SMTP_PASS=your_smtp_app_password
