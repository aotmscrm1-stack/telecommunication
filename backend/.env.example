PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/aotms
JWT_SECRET=your_jwt_secret_key_here
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000

# Meta WhatsApp Cloud API
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERIFY_TOKEN=zest_eat_meta_verify_8f9q2a

# Telephony Integrations
KNOWLARITY_API_KEY=
CALLERDESK_API_KEY=
MAQSAM_ACCESS_KEY=
MAQSAM_SECRET_KEY=

# Storage & Notifications
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FCM_SERVER_KEY=
OUTPERO_LEAD_INTAKE_URL=https://api.outpero.com/lead-intake/7b8iBMGIlDdrIOBdxf2Vrg
OUTPERO_LEAD_SECRET=
OUTPERO_ALLOWED_CAMPAIGNS=SAP

# Privileged account allow-lists (comma separated ObjectIds). Optional - these
# override the built-in fallback ids used by core/middleware/auth.js
ADMIN_IDS=
MANAGER_IDS=

# Comma separated list of extra origins allowed to call the API (CORS)
FRONTEND_URL=http://localhost:3000

# -- Process role & scaling ---------------------------------------------------
# api    = HTTP + WebSockets only, never starts background schedulers (safe to
#          run several replicas behind a load balancer)
# worker = background schedulers only, no HTTP listener (run one instance)
# all    = both in one process (default; local development and simple installs)
PROCESS_ROLE=all

# Name of the Mongo lease that decides which process runs the schedulers. Only
# change this if you deliberately want a second, independent scheduler pool.
SCHEDULER_LEASE_KEY=background-worker

# Optional: identifies this worker in lease rows and logs. Defaults to the
# container hostname plus the pid.
WORKER_ID=

# -- Local audio cache --------------------------------------------------------
# Where incoming call recordings are written before being pushed to Cloudinary.
# In Docker this must point at the mounted volume (compose sets
# /app/uploads/recordings); otherwise recordings land on the container's
# writable layer and disappear on the next rebuild.
RECORDINGS_DIR=
TEMP_RECORDINGS_DIR=

# How long the local copy is kept after a recording is safely in Cloudinary.
# 0 deletes it on the next sweep. Cloudinary remains the source of truth.
RECORDINGS_LOCAL_RETENTION_MINUTES=120

# -- Container sizing (read by compose.yaml only) -----------------------------
# Raise these together when you resize the VPS. NODE_HEAP_MB should be roughly
# half of BACKEND_MEMORY so upload buffers still have room.
BACKEND_CPUS=3.0
BACKEND_MEMORY=6G
NODE_HEAP_MB=2048
WORKER_CPUS=1.0
WORKER_MEMORY=1G
WORKER_HEAP_MB=512
