# Dependencies
node_modules/
*/node_modules/

# Production builds
dist/
build/
*/dist/
*/build/

# Environment variables and secrets
.env
.env.local
.env.*.local
*.env
# Any file holding service-account / private-key material, whatever the extension
*serviceAccount*
**/serviceAccountKey*
*.base64.txt
*.pem
*.p12
*.pfx

# NOTE: frontend/.env.production is intentionally tracked — it only holds public
# VITE_* values that are baked into the bundle at build time, and the VPS deploy
# (git reset --hard + docker compose build) needs the file to be present.
# Never add a non-VITE_ secret to that file.

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Vite / Temp
.vite/
*/.vite/

# Mobile Builds & Packages
*.apk
*.aab
dist-test*
Mobile_APP/dist-test*

