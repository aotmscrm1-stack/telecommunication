{
  "name": "mobile_app",
  "version": "1.0.5",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.20.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.8",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "node -e \"const {execSync}=require('child_process'); execSync('eas build -p android --profile preview', {stdio:'inherit', env:{...process.env, EAS_NO_VCS:'1', EAS_PROJECT_ROOT:process.cwd()}})\"",
    "ota:update": "node -e \"const {execSync}=require('child_process'); execSync('eas update --branch preview --message Auto-OTA-Update', {stdio:'inherit', env:{...process.env, EAS_NO_VCS:'1', EAS_PROJECT_ROOT:process.cwd()}})\""
  },
  "private": true,
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
