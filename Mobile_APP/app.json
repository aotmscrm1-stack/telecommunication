{
  "expo": {
    "name": "AOTMS CRM",
    "slug": "aotms-crm",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/Logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aotms.crm",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AOTMS CRM requires your location to accurately record check-in and check-out attendance on your shifts."
      }
    },
    "android": {
      "package": "com.telecom.crm",
      "versionCode": 4,
      "usesCleartextTraffic": true,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/Logo.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS",
        "CALL_PHONE",
        "READ_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/Logo.png",
          "color": "#174EA6",
          "defaultChannel": "crm_notifications"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6efbff82-383c-417b-9baf-bac4c5c56a14"
      }
    },
    "owner": "jayaveer"
  }
}
